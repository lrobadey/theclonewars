#!/usr/bin/env python3
from __future__ import annotations

import os
import sys


MIN_PY = (3, 11)


def _ensure_supported_python() -> None:
    if sys.version_info >= MIN_PY:
        return

    repo_root = os.path.dirname(os.path.abspath(__file__))
    venv_python = os.path.join(repo_root, ".venv", "bin", "python")
    if os.path.exists(venv_python) and os.access(venv_python, os.X_OK):
        os.execv(venv_python, [venv_python, *sys.argv])

    sys.stderr.write(
        "This project requires Python >= 3.11.\n"
        f"Detected: {sys.version.splitlines()[0]}\n"
        "Fix: run `source .venv/bin/activate` (or create the venv), then re-run.\n"
    )
    raise SystemExit(2)


def main(argv: list[str] | None = None) -> int:
    _ensure_supported_python()

    repo_root = os.path.dirname(os.path.abspath(__file__))
    launcher = os.path.join(repo_root, "sim-v2", "run_server.py")
    args = argv if argv is not None else sys.argv[1:]
    print("Delegating to the v2 web app launcher: python sim-v2/run_server.py")
    os.execv(sys.executable, [sys.executable, launcher, *args])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
